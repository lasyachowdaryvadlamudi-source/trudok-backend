# TruDok AI Document & Identity Screening API — Environment Configuration

# Application Environment: 'development' (enables /docs and /redoc) or 'production' (disables /docs and enforces HTTPS)
ENVIRONMENT=development

# Secret API Key for authenticating requests via X-API-Key header
API_KEY=trudok-sih26188-secret-key-2026

# Database Connection URL:
# For Local Development (SQLite): sqlite:///./trudok.db
# For Production (Render / PostgreSQL): postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./trudok.db

# Explicit CORS Allow-list (comma-separated origins, no wildcard '*' in production)
ALLOWED_ORIGINS=https://verilens-nu.vercel.app,https://verilens.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Port (auto-assigned by cloud platforms like Render)
PORT=8000
